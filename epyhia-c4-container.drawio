                <mxCell id="ingest" value="&lt;b&gt;Brief ingest&lt;/b&gt; &lt;i&gt;[Component]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;brief hash · grounding_set from every numeral · LLM guardrail screen (claude-haiku-4-5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;arcSize=8;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="245" y="560" width="310" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="sink" value="&lt;b&gt;Demand sink /sink&lt;/b&gt; &lt;i&gt;[Component]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;stand-in social channel · machine-token auth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;arcSize=8;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="245" y="645" width="310" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="worker" value="&lt;b&gt;worker&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Python asyncio — Fly process, same image]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="720" y="400" width="650" height="680" as="geometry"/>
                </mxCell>
                <mxCell id="qloop" value="&lt;b&gt;Queue loop&lt;/b&gt; &lt;i&gt;[Component]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;claim: FOR UPDATE SKIP LOCKED + lease · sweeper: expired leases, orphaned actions · settle: run succeeded/failed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;arcSize=8;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="750" y="480" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="crew" value="&lt;b&gt;Agent crew&lt;/b&gt; &lt;i&gt;[PydanticAI 2.22]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Strategist — claude-opus-5 (plans via brand doc; no gate handles)&lt;br&gt;Web Builder — claude-sonnet-5 (streamed, ~64K)&lt;br&gt;Marketer — claude-sonnet-5&lt;br&gt;Reviewer — claude-haiku-4-5&lt;br&gt;Site Critic — claude-haiku-4-5&lt;br&gt;Ops — claude-haiku-4-5&lt;br&gt;&lt;i&gt;Fixed pipeline in code: plan → copy → site, with demand and money in parallel; then video render and outreach (publish per post + send_email, after the site is live)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;arcSize=8;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="750" y="610" width="270" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="grounding" value="&lt;b&gt;Grounding checks&lt;/b&gt; &lt;i&gt;[Component]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;normalise + set-difference vs literal ∪ derived → artifact clean / flagged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;arcSize=8;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="750" y="930" width="270" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="remotion" value="&lt;b&gt;Remotion renderer&lt;/b&gt; &lt;i&gt;[Component]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;npx remotion render subprocess (pinned 4.0.503, local)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;arcSize=8;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="480" width="290" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="gate" value="&lt;b&gt;ACTION GATE&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component — credential boundary]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sole holder of Vercel / Stripe / SMTP credentials — agents get typed capability handles with no key material.&lt;br&gt;Approval · idempotency (keys derive from the brief hash) · retry · audit.&lt;br&gt;Every adapter registers execute() and verify(); an effect is proved in the world before succeeded.&lt;br&gt;Refuses deploy while the site artifact is flagged.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontColor=#4D1F1C;verticalAlign=top;arcSize=6;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="590" width="290" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="adVercel" value="&lt;b&gt;Vercel adapter&lt;/b&gt; — deploy · verify probe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#8F3B37;fontColor=#ffffff;arcSize=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="820" width="250" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="adStripe" value="&lt;b&gt;Stripe adapter&lt;/b&gt; — catalogue, arm charge · verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#8F3B37;fontColor=#ffffff;arcSize=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="875" width="250" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="adEmail" value="&lt;b&gt;Email adapter&lt;/b&gt; — SMTP send · verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#8F3B37;fontColor=#ffffff;arcSize=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="930" width="250" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="adPublish" value="&lt;b&gt;Publish adapter&lt;/b&gt; — HTTP post to sink · verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#8F3B37;fontColor=#ffffff;arcSize=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="985" width="250" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="noteRpc" value="web and worker never call each other — every handoff is a durable tasks row in Postgres (at-least-once tasks, exactly-once effects at the gate)" style="text;html=1;align=left;verticalAlign=top;fontColor=#666666;fontStyle=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="240" y="780" width="320" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="postgres" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Neon — managed]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;runs · briefs · brand_docs · artifacts · tasks (the queue — no Redis, no Celery) · actions (audit + idempotency ledger, UNIQUE(idempotency_key)) · agent_calls / agent_cache · orders · sink_posts · cost ledger&lt;br&gt;Migrations: Alembic, run as the Fly release step&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="380" y="1180" width="440" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="anthropic" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;i&gt;[External SaaS]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Opus 5 / Sonnet 5 / Haiku 4.5. ANTHROPIC_API_KEY lives in process env, outside the gate — inference is metered, not gated; LLM and gate spend share one budget.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#707070;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="1500" y="400" width="260" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="vercelExt" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;&lt;i&gt;[External SaaS]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hosts the deployed client site — static HTML/CSS/JS, no framework, no build step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#707070;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
