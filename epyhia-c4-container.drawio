                <mxCell id="console" value="&lt;b&gt;Console&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: React SPA — Vite, TanStack Router/Query, Tailwind, shadcn/ui]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Operator UI: runs, artifacts, approvals, cost. Built bundle served by web; runs in the operator's browser.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
