                <mxCell id="auth0" value="&lt;b&gt;Auth0&lt;/b&gt;&lt;br&gt;&lt;i&gt;[External SaaS]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OIDC login for the console; JWT audience epyhia.fly.dev/api&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#707070;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
