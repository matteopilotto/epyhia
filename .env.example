# Postgres (Neon in production, docker-compose locally)
DATABASE_URL=postgresql+asyncpg://epyhia:epyhia@localhost:5432/epyhia

# The test suite truncates this database, so it must differ from DATABASE_URL —
# the suite refuses to run otherwise. Created for you on a fresh postgres volume;
# on an existing one, once:
#   docker compose exec postgres psql -U epyhia -c 'CREATE DATABASE epyhia_test'
TEST_DATABASE_URL=postgresql+asyncpg://epyhia:epyhia@localhost:5432/epyhia_test

# Inference — deliberately outside the Action Gate, metered not gated
ANTHROPIC_API_KEY=

# Action Gate credentials — absent locally means the app starts and the
# gated action fails with `credential not configured: <provider>` (FR-064)
VERCEL_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP — Mailpit locally, no account signup required (FR-065)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025

# Where the deployed site posts a buy click — this API's own public origin
PUBLIC_API_URL=http://localhost:8000

# Recording sink (social publish stand-in)
SINK_BASE_URL=http://localhost:8000/sink
SINK_TOKEN=

# Auth0
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Cost governance
RUN_BUDGET_USD=25
DAILY_CEILING_USD=100
