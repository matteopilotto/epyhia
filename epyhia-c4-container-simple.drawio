                </mxCell>
                <mxCell id="console" value="&lt;b&gt;Console&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: React SPA]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Operator UI: runs, artifacts, approvals, cost. Served by web, runs in the browser.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="220" y="110" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="auth0" value="&lt;b&gt;Auth0&lt;/b&gt;&lt;br&gt;&lt;i&gt;[External SaaS]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OIDC login for the console&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#707070;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="120" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="web" value="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: FastAPI — Fly process]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;REST /api + SSE · brief ingest (hash + grounding set) · Stripe webhook receiver · demand sink · serves the console bundle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="220" y="350" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="worker" value="&lt;b&gt;worker&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: Python asyncio — Fly process, same image]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Queue loop over the tasks table · grounding checks · Remotion video render&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="580" y="350" width="400" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="crew" value="&lt;b&gt;Agent crew&lt;/b&gt; &lt;i&gt;[PydanticAI]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Strategist (Opus — plans via the brand doc, no gate handles)&lt;br&gt;Web BuilderMarketer (Sonnet)&lt;br&gt;Reviewer, Site Critic, Ops (Haiku)&lt;br&gt;&lt;i&gt;Pipeline fixed in code: copy → site, demand, money; then video + outreach&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;arcSize=8;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="600" y="420" width="360" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="gate" value="&lt;b&gt;ACTION GATE&lt;/b&gt; &lt;i&gt;[credential boundary]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sole holder of Vercel / Stripe / SMTP credentials — agents get typed capability handles, no keys. Approval · idempotency (keys from the brief hash) · every action verified in the world before succeeded · refuses deploy while the site is flagged.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontColor=#4D1F1C;verticalAlign=top;arcSize=6;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="600" y="590" width="360" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="postgres" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Neon — managed]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;runs · briefs · brand docs · artifacts · tasks (the queue)&amp;nbsp; actions (audit + idempotency ledger) · orders · cost ledger&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="400" y="830" width="400" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="anthropic" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;i&gt;[External SaaS]&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Opus 5 / Sonnet 5 / Haiku 4.5. API key in the worker env, outside the gate — inference metered, not gated; one shared budget.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#707070;fontColor=#ffffff;verticalAlign=top;arcSize=6;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="300" width="240" height="110" as="geometry"/>
                </mxCell>
