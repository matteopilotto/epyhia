                    <mxGeometry x="60" y="115" width="70" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="buyer" value="Visitor" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#08427B;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontSize=12;fontStyle=1;" parent="1" vertex="1">
